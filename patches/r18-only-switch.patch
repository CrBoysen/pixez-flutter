+      final fresh = _r18RankCache!
+          .where((e) => !exists.contains(e.id))
+          .map((e) => IllustStore(e.id, e))
+          .toList();
+      if (fresh.isEmpty) return;
+      fresh.shuffle(Random());
+      iStores.addAll(fresh.take(30));
+    } catch (e) {
+      // 补量失败不影响推荐主流展示
+    }
+  }
+
+  Future<List<Illusts>> loadR18Ranking() async {
+    Response response = await apiClient.getIllustRanking("week_r18", null);
+    return Recommend.fromJson(response.data).illusts;
+  }
