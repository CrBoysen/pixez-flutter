+      await Future<void>.delayed(Duration.zero);
+      int guard = 0;
+      while (r18Only &&
+          iStores.length < R18_MIN_COUNT &&
+          guard < r18FillGuard &&
+          nextUrl != null &&
+          nextUrl!.isNotEmpty) {
+        guard++;
+        await fetchNext();
+      }
+      if (r18Only && iStores.length < R18_MIN_COUNT) {
+        await appendR18Ranking();
+      }
+    } finally {
+      _fillingR18 = false;
+    }
+  }
